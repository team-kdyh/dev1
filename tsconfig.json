{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/main.ts",
    "src/adapter/**/*.ts",
    "src/app/**/*.ts",
    "src/input/**/*.ts",
    "src/render/**/*.ts",
    "src/screens/**/*.ts",
    "src/sim/**/*.ts",
    "src/ui/**/*.ts",
    "src/data/**/*.ts"
  ]
}
