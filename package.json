{
  "name": "tech-war-track-c",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:balance": "tsx tools/balance-validator/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "batch": "tsx tools/batch/cli.ts",
    "editor": "vite --config tools/balance-editor/vite.config.ts",
    "build:editor": "vite build --config tools/balance-editor/vite.config.ts",
    "check": "npm run validate:balance && npm run typecheck && npm run test && npm run build:editor"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  }
}
