{
  "name": "tech-war",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:client && vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:client && npm run typecheck:track-c",
    "validate:balance": "tsx tools/balance-validator/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "batch": "tsx tools/batch/cli.ts",
    "editor": "vite --config tools/balance-editor/vite.config.ts",
    "build:editor": "vite build --config tools/balance-editor/vite.config.ts",
    "check": "npm run validate:balance && npm run typecheck && npm run test && npm run build && npm run build:editor",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:track-c": "tsc --noEmit -p tsconfig.track-c.json",
    "generate:placeholders": "python3 assets/tools/generate_placeholders.py",
    "generate:unit-art": "python3 assets/tools/generate_unit_art.py",
    "generate:audio": "python3 assets/tools/generate_audio.py",
    "validate:audio": "python3 assets/tools/validate_audio.py",
    "preview:assets": "python3 assets/tools/make_previews.py",
    "preview:images": "python3 assets/tools/make_image_gallery.py",
    "pack:assets": "python3 assets/tools/pack_assets.py",
    "validate:assets": "python3 assets/tools/validate_assets.py"
  },
  "dependencies": {
    "pixi.js": "^8.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
