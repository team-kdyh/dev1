{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tech-war.local/schema/asset-manifest.schema.json",
  "type": "object", "additionalProperties": false, "required": ["$schema", "placeholder", "keys"],
  "properties": {
    "$schema": { "type": "string" },
    "placeholder": { "type": "boolean" },
    "keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_.]+$" } }
  }
}
