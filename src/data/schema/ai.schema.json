{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tech-war.local/schema/ai.schema.json",
  "type": "object", "additionalProperties": false, "required": ["$schema", "difficulties"],
  "properties": {
    "$schema": { "type": "string" },
    "difficulties": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "reactionDelaySeconds", "resourceEfficiency", "counterAccuracy", "strategyUseChance", "activeUseChance"],
        "properties": {
          "id": { "enum": ["easy", "normal", "hard", "expert"] },
          "reactionDelaySeconds": { "type": "number", "minimum": 0 },
          "resourceEfficiency": { "type": "number", "minimum": 0, "maximum": 1 },
          "counterAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
          "strategyUseChance": { "type": "number", "minimum": 0, "maximum": 1 },
          "activeUseChance": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
