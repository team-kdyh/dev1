{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tech-war.local/schema/strategy.schema.json",
  "type": "object", "additionalProperties": false, "required": ["$schema", "strategies"],
  "properties": {
    "$schema": { "type": "string" },
    "strategies": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "faction", "name", "cooldown", "trigger", "target", "effects"],
        "properties": {
          "id": { "type": "string" }, "faction": { "enum": ["semicon", "orchard"] }, "name": { "type": "string" },
          "cooldown": { "type": "number", "exclusiveMinimum": 0 }, "trigger": { "const": "active" },
          "target": { "type": "object", "required": ["type"], "additionalProperties": true },
          "effects": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type"], "additionalProperties": true } }
        }
      }
    }
  }
}
