{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tech-war.local/schema/research.schema.json",
  "type": "object", "additionalProperties": false, "required": ["$schema", "rankedPolicy", "quickMatchPolicy", "nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "rankedPolicy": { "const": "disabled" }, "quickMatchPolicy": { "const": "enabled" },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "faction", "levels", "requires"],
        "properties": {
          "id": { "type": "string", "pattern": "^(semicon|orchard)_[a-z0-9_]+$" }, "name": { "type": "string" },
          "faction": { "enum": ["semicon", "orchard"] },
          "levels": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["cost", "effect"],
              "properties": {
                "cost": { "type": "integer", "exclusiveMinimum": 0 },
                "effect": { "type": "object", "required": ["type", "value"], "additionalProperties": true }
              }
            }
          },
          "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
