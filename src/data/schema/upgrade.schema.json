{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tech-war.local/schema/upgrade.schema.json",
  "type": "object", "additionalProperties": false, "required": ["$schema", "upgrades"],
  "properties": {
    "$schema": { "type": "string" },
    "upgrades": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "maxLevel", "costs", "effect"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" }, "name": { "type": "string" },
          "maxLevel": { "type": "integer", "minimum": 1 },
          "costs": { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } },
          "effect": {
            "type": "object", "additionalProperties": false, "required": ["type", "values"],
            "properties": { "type": { "type": "string" }, "values": { "type": "array", "minItems": 1, "items": { "type": "number" } } }
          }
        }
      }
    }
  }
}
