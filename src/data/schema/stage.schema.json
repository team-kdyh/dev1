{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tech-war.local/schema/stage.schema.json",
  "type": "object", "additionalProperties": false, "required": ["$schema", "stages"],
  "properties": {
    "$schema": { "type": "string" },
    "stages": {
      "type": "array", "minItems": 24, "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "faction", "name", "desc", "enemyFaction", "aiDifficulty", "rules", "rewards", "unlockRequires"],
        "properties": {
          "id": { "type": "string", "pattern": "^(semicon|orchard)_(0[1-9]|1[0-2])$" },
          "faction": { "enum": ["semicon", "orchard"] }, "name": { "type": "string", "minLength": 1 }, "desc": { "type": "string", "minLength": 1 },
          "enemyFaction": { "enum": ["semicon", "orchard"] }, "aiDifficulty": { "enum": ["easy", "normal", "hard", "expert"] },
          "rules": {
            "type": "object", "additionalProperties": false,
            "required": ["startCash", "cashRateMod", "unitCostMod", "productionCooldownMod", "baseHp", "enemyBaseHp", "timeLimit", "bannedUnits", "startAge", "upgradesEnabled"],
            "properties": {
              "startCash": { "type": "number", "minimum": 0 }, "cashRateMod": { "type": "number", "exclusiveMinimum": 0 },
              "unitCostMod": { "type": "number", "exclusiveMinimum": 0 }, "productionCooldownMod": { "type": "number", "exclusiveMinimum": 0 },
              "baseHp": { "type": "number", "exclusiveMinimum": 0 }, "enemyBaseHp": { "type": "number", "exclusiveMinimum": 0 },
              "timeLimit": { "type": "number", "exclusiveMinimum": 0 },
              "bannedUnits": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "startAge": { "type": "integer", "minimum": 1, "maximum": 4 }, "upgradesEnabled": { "type": "boolean" },
              "enemyStatMod": { "type": "number", "exclusiveMinimum": 0 }, "tutorialFocus": { "type": "string" },
              "enemyBossAt": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "rewards": {
            "type": "object", "additionalProperties": false, "required": ["rp", "firstClearRp"],
            "properties": { "rp": { "type": "integer", "minimum": 0 }, "firstClearRp": { "type": "integer", "minimum": 0 } }
          },
          "unlockRequires": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
