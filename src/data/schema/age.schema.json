{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tech-war.local/schema/age.schema.json",
  "type": "object", "additionalProperties": false, "required": ["$schema", "ages"],
  "properties": {
    "$schema": { "type": "string" },
    "ages": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["age", "name", "tiers", "cost", "cumulativeCashRequired", "globalStatBonus"],
        "properties": {
          "age": { "type": "integer", "minimum": 1, "maximum": 4 }, "name": { "type": "string" },
          "tiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 9 } },
          "cost": { "type": "number", "minimum": 0 }, "cumulativeCashRequired": { "type": "number", "minimum": 0 },
          "previousAgeSecondsRequired": { "type": "number", "minimum": 0 }, "globalStatBonus": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
